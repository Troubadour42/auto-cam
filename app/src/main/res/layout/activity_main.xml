<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg">

    <ScrollView
        android:id="@+id/home"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="16dp"
            android:paddingEnd="20dp"
            android:paddingBottom="28dp">

            <LinearLayout
                android:id="@+id/previewRow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/sideColumn"
                    android:layout_width="112dp"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/sideStart"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/icon_btn"
                        android:contentDescription="Start recording"
                        android:padding="16dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_record" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:text="Start\nrecording"
                        android:textColor="@color/cream"
                        android:textSize="12sp" />

                    <ImageButton
                        android:id="@+id/sideEnd"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/icon_btn"
                        android:contentDescription="End recording"
                        android:padding="18dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_stop" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:text="End\nrecording"
                        android:textColor="@color/cream"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:id="@+id/sideClock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <View
                            android:id="@+id/recDot"
                            android:layout_width="12dp"
                            android:layout_height="12dp"
                            android:background="@drawable/dot_red" />

                        <TextView
                            android:id="@+id/timer"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="0:00"
                            android:textColor="@color/cream"
                            android:textSize="16sp" />
                    </LinearLayout>
                </LinearLayout>

                <app.autocam.AspectFrameLayout
                    android:id="@+id/previewCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/card_round">

                    <androidx.camera.view.PreviewView
                        android:id="@+id/preview"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:implementationMode="compatible"
                        app:scaleType="fitCenter" />

                    <ImageView
                        android:id="@+id/previewLockup"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_gravity="center"
                        android:contentDescription="Close Auto Cam"
                        android:padding="8dp"
                        android:src="@drawable/auto_cam_lockup" />

                    <app.autocam.GlowBorderView
                        android:id="@+id/previewGlow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:visibility="gone" />
                </app.autocam.AspectFrameLayout>

                <Space
                    android:id="@+id/sideSpacer"
                    android:layout_width="112dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/portraitClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:id="@+id/portraitDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/dot_red" />

                <TextView
                    android:id="@+id/portraitTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="0:00"
                    android:textColor="@color/cream"
                    android:textSize="16sp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/lockup"
                android:layout_width="match_parent"
                android:layout_height="92dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:contentDescription="Close Auto Cam"
                android:src="@drawable/auto_cam_lockup" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="12dp"
                android:text="Normal view."
                android:textColor="@color/muted"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/statusText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:background="@drawable/pill_bg"
                android:drawablePadding="8dp"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:text="READY"
                android:textAllCaps="true"
                android:textColor="@color/muted"
                android:textSize="11sp"
                android:letterSpacing="0.18" />

            <LinearLayout
                android:id="@+id/rowOpen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:background="@drawable/row_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Open"
                    android:textColor="@color/cream"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btnOpen"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/icon_btn"
                    android:contentDescription="Open camera"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_camera" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowRecord"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/row_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Record"
                    android:textColor="@color/cream"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btnRecord"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/icon_btn"
                    android:contentDescription="Start recording"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_record" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowEnd"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/row_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="End"
                    android:textColor="@color/cream"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btnEnd"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/icon_btn"
                    android:contentDescription="End recording"
                    android:padding="12dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_stop" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/rowFrame"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/row_bg"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="10dp"
                android:paddingBottom="10dp">

                <TextView
                    android:id="@+id/frameLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Portrait"
                    android:textColor="@color/cream"
                    android:textSize="16sp" />

                <ImageButton
                    android:id="@+id/btnFrame"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/icon_btn"
                    android:contentDescription="Portrait"
                    android:padding="10dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/ic_frame" />
            </LinearLayout>

            <TextView
                android:id="@+id/openCamera"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="22dp"
                android:background="@drawable/btn_cream"
                android:gravity="center"
                android:text="Open camera"
                android:textColor="@color/ink"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="12dp"
                android:text="Use the buttons to open the camera and record."
                android:textColor="@color/muted"
                android:textSize="14sp" />
        </LinearLayout>
    </ScrollView>

    <FrameLayout
        android:id="@+id/live"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/black"
        android:visibility="gone">

        <FrameLayout
            android:id="@+id/liveStage"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <app.autocam.GlowBorderView
            android:id="@+id/liveFrame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/liveSide"
            android:layout_width="112dp"
            android:layout_height="wrap_content"
            android:layout_gravity="start|center_vertical"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/liveStart"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:background="@drawable/btn_round"
                android:contentDescription="Start recording"
                android:padding="16dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_record" />

            <ImageButton
                android:id="@+id/liveEnd"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_marginTop="18dp"
                android:background="@drawable/btn_round"
                android:contentDescription="End recording"
                android:padding="18dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_stop" />

            <LinearLayout
                android:id="@+id/liveClock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <View
                    android:id="@+id/liveDot"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/dot_red" />

                <TextView
                    android:id="@+id/liveTimer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="0:00"
                    android:textColor="@color/cream"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/hud_bg"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:id="@+id/liveStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="Ready"
                    android:textColor="@color/cream"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/liveFrameToggle"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/btn_outline"
                    android:gravity="center"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:text="Portrait"
                    android:textColor="@color/cream"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/flip"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/icon_btn"
                        android:contentDescription="Switch camera"
                        android:padding="12dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_switch" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <FrameLayout
                        android:id="@+id/shutter"
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/shutter_ring">

                        <View
                            android:id="@+id/shutterCore"
                            android:layout_width="56dp"
                            android:layout_height="56dp"
                            android:layout_gravity="center"
                            android:background="@drawable/shutter_dot" />
                    </FrameLayout>

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/closeLive"
                        android:layout_width="wrap_content"
                        android:layout_height="48dp"
                        android:gravity="center"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:text="Close"
                        android:textColor="@color/cream"
                        android:textSize="14sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/livePortraitClock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <View
                        android:id="@+id/livePortraitDot"
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:background="@drawable/dot_red" />

                    <TextView
                        android:id="@+id/livePortraitTimer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="0:00"
                        android:textColor="@color/cream"
                        android:textSize="16sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <ScrollView
        android:id="@+id/review"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <ImageView
                android:id="@+id/reviewLockup"
                android:layout_width="180dp"
                android:layout_height="56dp"
                android:layout_gravity="center_horizontal"
                android:contentDescription="Close Auto Cam"
                android:src="@drawable/auto_cam_lockup" />

            <TextView
                android:id="@+id/reviewTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="8dp"
                android:paddingBottom="16dp"
                android:text="Preview"
                android:textColor="@color/cream"
                android:textSize="32sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/reviewSide"
                    android:layout_width="112dp"
                    android:layout_height="wrap_content"
                    android:gravity="center_horizontal"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageButton
                        android:id="@+id/sideSave"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:background="@drawable/btn_cream"
                        android:contentDescription="Save"
                        android:padding="16dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_download" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:text="Save"
                        android:textColor="@color/cream"
                        android:textSize="12sp" />

                    <ImageButton
                        android:id="@+id/sideDelete"
                        android:layout_width="64dp"
                        android:layout_height="64dp"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/icon_btn"
                        android:contentDescription="Delete"
                        android:padding="16dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_trash" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:paddingTop="6dp"
                        android:text="Delete"
                        android:textColor="@color/cream"
                        android:textSize="12sp" />
                </LinearLayout>

                <app.autocam.AspectFrameLayout
                    android:id="@+id/reviewCard"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/card_round">

                    <app.autocam.FillVideoView
                        android:id="@+id/playback"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_gravity="center" />

                    <View
                        android:id="@+id/playbackTouch"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:clickable="true"
                        android:focusable="true" />

                    <app.autocam.GlowBorderView
                        android:id="@+id/reviewGlow"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <ImageButton
                        android:id="@+id/pause"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:layout_gravity="center"
                        android:background="@drawable/pause_btn"
                        android:contentDescription="Pause"
                        android:padding="18dp"
                        android:scaleType="centerInside"
                        android:src="@drawable/ic_pause"
                        android:visibility="gone" />
                </app.autocam.AspectFrameLayout>

                <Space
                    android:id="@+id/reviewSpacer"
                    android:layout_width="112dp"
                    android:layout_height="1dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/reviewButtons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/save"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_cream"
                    android:gravity="center"
                    android:text="Save"
                    android:textColor="@color/ink"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/delete"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:background="@drawable/btn_outline"
                    android:gravity="center"
                    android:text="Delete"
                    android:textColor="@color/cream"
                    android:textSize="16sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <TextView
        android:id="@+id/message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:padding="20dp"
        android:textColor="@color/rec"
        android:textSize="14sp"
        android:visibility="gone" />
</FrameLayout>
